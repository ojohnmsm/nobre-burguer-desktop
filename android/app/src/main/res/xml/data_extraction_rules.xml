<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: nada de SharedPreferences no backup em nuvem nem na
     transferência para outro aparelho. Lá moram o token da loja (cifrado pelo
     vigia nativo, e em texto no armazenamento do Capacitor) e o estado do
     vigia — tablet novo pareia de novo, não herda credencial. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
        <exclude domain="database" path="." />
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
        <exclude domain="database" path="." />
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
