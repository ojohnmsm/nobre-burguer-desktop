{
  "name": "cardapia-desktop",
  "version": "1.1.10",
  "description": "Cardapia — Gerenciador de Pedidos",
  "main": "dist-electron/main/main.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build && electron-builder",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "release": "node scripts/release.mjs"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "lucide-react": "^1.17.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^41.10.4",
    "electron-builder": "^26.15.3",
    "electron-vite": "^3.0.0",
    "postcss": "^8.5.26",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.0.7"
  },
  "build": {
    "appId": "shop.cardapia.desktop",
    "productName": "Cardapia",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "asar": true,
    "win": {
      "target": "nsis",
      "icon": "build/icon.png",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Cardapia"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "extraResources": [
      {
        "from": "build/icon.png",
        "to": "tray-icon.png"
      }
    ],
    "publish": {
      "provider": "github",
      "owner": "ojohnmsm",
      "repo": "nobre-burguer-desktop",
      "releaseType": "release"
    }
  },
  "author": "Cardapia"
}
